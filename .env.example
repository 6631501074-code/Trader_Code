# ============================================================
# Environment Variables — Copy this to .env and fill in values
# ============================================================

# --- LLM: Ollama (Gemma3 4b local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- MT5 Broker (XM) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_xm_password
MT5_SERVER=XMGlobal-MT5 3          # ดูจาก XM terminal เช่น XMGlobal-MT5 2
MT5_PATH=C:\Program Files\XM Global MT5 Terminal\terminal64.exe

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trader_db
POSTGRES_USER=trader_user
POSTGRES_PASSWORD=your_pg_password
DATABASE_URL=postgresql+asyncpg://trader_user:your_pg_password@localhost:5432/trader_db

# --- Safety Limits ---
MAX_RISK_PCT=0.02                 # Risk สูงสุดต่อไม้ = 2%
MIN_LOT=0.01
MAX_LOT=5.0
DATA_STALENESS_SECONDS=30        # ถ้าข้อมูลค้างเกิน 30 วิ → HOLD
JSON_REPAIR_MAX_RETRIES=3

# --- System ---
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production
